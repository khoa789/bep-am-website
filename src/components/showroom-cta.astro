---
import { contact } from "../data/site-content";
---

<section
  class="section showroom"
  id="showroom"
  aria-labelledby="showroom-title"
>
  <div class="container showroom-grid">
    <div>
      <p class="section-label">Bếp Ấm · Cần Thơ</p>
      <h2 id="showroom-title">
        Có những điều,
        <br />
        nên đến để <em>tự tay cảm nhận.</em>
      </h2>
      <p class="lede">
        Mở một ngăn kéo. Chạm một mặt đá. Cùng chúng tôi tìm ra điều phù hợp với
        căn bếp của gia đình bạn.
      </p>
      <a
        class="text-link"
        href={contact.mapHref}
        target="_blank"
        rel="noreferrer"
      >
        Xem đường đến showroom <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="consultation" id="tu-van">
      <h3>Hẹn một buổi tư vấn</h3>
      <p>
        Gọi Bếp Ấm để chọn thời gian thuận tiện. Bạn có thể mang theo mặt bằng
        hoặc vài hình ảnh căn bếp mình yêu thích.
      </p>
      <a class="button button--primary" href={contact.phoneHref}>
        Gọi đặt lịch tư vấn <span aria-hidden="true">↗</span>
      </a>
      <div class="phones" aria-label="Số điện thoại tư vấn">
        <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
        <a href={contact.secondaryPhoneHref}>{contact.secondaryPhoneDisplay}</a>
      </div>
      <p class="visit-note">Bạn cũng có thể ghé showroom trực tiếp.</p>
      <address>{contact.address}</address>
      <p class="opening-hours">{contact.openingHours}</p>
    </div>
  </div>
</section>
<style>
  .showroom {
    background: var(--color-surface);
  }
  .showroom-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 5rem;
  }
  .showroom h2 {
    max-width: 22ch;
  }
  .showroom .lede {
    margin-top: 1.5rem;
  }
  .consultation {
    border-left: 1px solid var(--color-line);
    padding-left: 3rem;
    scroll-margin-top: 2rem;
  }
  .consultation h3 {
    margin-bottom: 1rem;
  }
  .consultation > p {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .consultation .button {
    margin-top: 0.5rem;
  }
  .phones {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.5rem;
    margin: 1rem 0 0.25rem;
  }
  .phones a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    color: var(--color-ink);
    font-size: 1.125rem;
    letter-spacing: 0.06em;
  }
  .consultation address {
    font-style: normal;
    font-size: 0.9375rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
    margin-top: 1.5rem;
  }
  .opening-hours {
    margin-top: 0.75rem;
  }
  .visit-note {
    font-size: 0.8125rem !important;
  }
  @media (max-width: 700px) {
    .showroom-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .consultation {
      border-left: 0;
      border-top: 1px solid var(--color-line);
      padding: 2rem 0 0;
    }
    .consultation .button {
      width: 100%;
    }
  }
</style>
