---
import BaseLayout from "../layouts/base-layout.astro";
import SiteHeader from "../components/site-header.astro";
---

<BaseLayout title="Không tìm thấy trang | Bếp Ấm" description="Trang bạn đang tìm không tồn tại hoặc đã được chuyển đi.">
  <SiteHeader />
  <main class="not-found" id="noi-dung-chinh">
    <div class="container">
      <p class="eyebrow">404 · Không tìm thấy trang</p>
      <h1>Mời bạn trở về gian bếp.</h1>
      <p class="lede">Đường dẫn này không còn tồn tại. Trang chủ vẫn có đầy đủ giải pháp và thông tin showroom Bếp Ấm.</p>
      <a class="button button--primary" href="/">Về trang chủ</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found { min-height: calc(100svh - 5.5rem); display: grid; align-items: center; padding-block: var(--section-space); }
  .not-found .button { margin-top: 2rem; }
</style>
