---
import EditorialLayout from "../../layouts/editorial-layout.astro";
import CollectionAlbum from "../../components/collection-album.astro";
import { collectionAlbums } from "../../data/collection-albums";
import { collections, kitchenConcepts } from "../../data/editorial-content";
import "../../styles/collection-discovery.css";
export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }));
}
const { collection } = Astro.props;
const originalCover = kitchenConcepts.find((item) => item.image === collection.image);
const collectionIndex = collections.findIndex((item) => item.slug === collection.slug);
const relatedCollections = [1, 2].map((offset) => collections[(collectionIndex + offset) % collections.length]);
---

<EditorialLayout
  title={collection.title}
  description={collection.description}
  image={`/images/${collection.image}-1600.webp`}
  category="Bộ sưu tập bếp đẹp"
>
  <nav class="collection-navigation" aria-label="Điều hướng bộ sưu tập">
    <a class="text-link" href="/bo-suu-tap/">← Xem tất cả {collections.length} bộ sưu tập</a>
  </nav>
  {originalCover && <figure class="editorial-cover">
    <img
      src={`/images/${collection.image}-1600.webp`}
      width="1600"
      height="900"
      alt={originalCover.alt}
    />
    <figcaption>
      Phối cảnh ý tưởng tạo bằng AI, lấy cảm hứng từ vật liệu Lecmax. Cấu hình
      được tư vấn theo mặt bằng thực tế.
    </figcaption>
  </figure>}
  <CollectionAlbum
    images={collectionAlbums[collection.slug] ?? []}
    slug={collection.slug}
    title={collection.title}
  />
  <div class="editorial-prose">
    <h2>{collection.intro}</h2>
    {collection.sections.map((section) => (
      <section>
        <h3>{section.title}</h3>
        <p>{section.body}</p>
      </section>
    ))}
  </div>
  {collection.images.length > 0 && <div class="collection-gallery">
    {collection.images
      .filter((number) => `kitchen-concept-${number}` !== collection.image)
      .map((number) => (
        <figure>
          <img
            src={`/images/kitchen-concept-${number}-1600.webp`}
            width="1600"
            height="900"
            loading="lazy"
            alt={kitchenConcepts[number - 1].alt}
          />
          <figcaption>
            {kitchenConcepts[number - 1].title} · Phối cảnh AI
          </figcaption>
        </figure>
      ))}
  </div>}
  <a class="button button--primary" href="#tu-van">
    Tư vấn cho không gian của bạn ↗
  </a>
  <nav class="related-links" aria-label="Bộ sưu tập khác">
    {relatedCollections
      .map((item) => (
        <a href={`/bo-suu-tap/${item.slug}/`}>{item.title} ↗</a>
      ))}
    <a href="/bo-suu-tap/">Xem tất cả {collections.length} bộ sưu tập ↗</a>
  </nav>
</EditorialLayout>
