---
import BaseLayout from "../layouts/base-layout.astro";
import KitchenStory from "../components/kitchen-story.astro";
import ShowroomCta from "../components/showroom-cta.astro";
import SiteHeader from "../components/site-header.astro";
import SolutionEcosystem from "../components/solution-ecosystem.astro";
import { contact, processSteps, selectionStandards } from "../data/site-content";
import "../styles/home.css";

const title = "Bếp Ấm | Giải pháp không gian bếp trọn gói tại Cần Thơ";
const description =
  "Bếp Ấm tuyển chọn và kết nối hệ tủ Lecmax, đá Vicostone, thiết bị Panasonic, chậu vòi Konox thành giải pháp không gian bếp trọn gói tại Cần Thơ.";
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: "Bếp Ấm",
  description,
  telephone: "+84923179169",
  address: {
    "@type": "PostalAddress",
    streetAddress: "168C Xô Viết Nghệ Tĩnh",
    addressLocality: "Ninh Kiều",
    addressRegion: "Cần Thơ",
    addressCountry: "VN",
  },
  sameAs: [contact.facebookHref],
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(localBusiness)} is:inline />
  <SiteHeader />

  <main id="noi-dung-chinh">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Bếp Ấm · Giải pháp bếp trọn gói</p>
          <h1 class="display-title" id="hero-title">Một nơi,<br />trọn vẹn gian bếp.</h1>
          <p class="hero-lede">
            Từ hệ tủ, mặt đá, thiết bị đến chậu vòi, Bếp Ấm chọn từng thương hiệu bằng
            cùng một tiêu chuẩn để gia đình an tâm từ lúc cân nhắc đến khi sử dụng.
          </p>
          <div class="hero-actions">
            <a class="button button--primary" href="#showroom">Ghé showroom trải nghiệm</a>
            <a class="button button--secondary" href={contact.phoneHref}>
              Gọi {contact.phoneDisplay}
            </a>
          </div>
          <p class="hero-note">Tư vấn trực tiếp · Xem vật liệu thật · Thử thao tác tại showroom</p>
        </div>

        <div class="kitchen-study" role="img" aria-label="Minh họa kỹ thuật một không gian bếp ấm với hệ tủ, mặt đá, thiết bị và vùng chậu">
          <div class="study-label">Một hệ thống đồng bộ</div>
          <div class="study-wall" aria-hidden="true">
            <span class="study-cabinet study-cabinet--one"></span>
            <span class="study-cabinet study-cabinet--two"></span>
            <span class="study-cabinet study-cabinet--three"></span>
            <span class="study-hood"></span>
            <span class="study-counter"></span>
            <span class="study-sink"></span>
            <span class="study-faucet"></span>
            <span class="study-base study-base--one"></span>
            <span class="study-base study-base--two"></span>
            <span class="study-appliance"></span>
            <span class="study-island"></span>
          </div>
          <div class="study-index" aria-hidden="true">01—04</div>
          <p class="study-caption">Minh họa không gian · Không phải thiết kế cho một công trình cụ thể</p>
        </div>
      </div>
    </section>

    <section class="section promise" aria-labelledby="promise-title">
      <div class="container promise-grid">
        <p class="promise-index" aria-hidden="true">01</p>
        <div>
          <p class="eyebrow">Sự an tâm bắt đầu từ lựa chọn</p>
          <h2 id="promise-title">Bạn không cần trở thành chuyên gia để làm được một căn bếp tốt.</h2>
        </div>
        <div class="promise-copy">
          <p>
            Bếp Ấm nhận phần khó về mình: tìm hiểu cấu tạo, đối chiếu công năng, phối hợp
            kích thước và kết nối các đơn vị trong cùng một phương án.
          </p>
          <p>
            Mỗi thương hiệu được chọn vì một vai trò rõ ràng. Khi ghép lại, chúng cần phục
            vụ cùng một điều — nhịp sống thật của gia đình bạn.
          </p>
        </div>
      </div>
    </section>

    <SolutionEcosystem />

    <KitchenStory />

    <section class="section system-story" aria-labelledby="system-title">
      <div class="container system-heading">
        <p class="eyebrow">Một căn bếp vận hành như một hệ thống</p>
        <h2 id="system-title">Đẹp ở từng phần. Thuận tiện khi dùng cùng nhau.</h2>
      </div>
      <div class="container system-map" aria-label="Mối liên kết giữa bốn lớp giải pháp">
        <article>
          <p class="system-number">01</p>
          <h3>Hệ tủ tạo nền</h3>
          <p>Khoang lưu trữ, thiết bị và đường kỹ thuật được tính từ cấu trúc chung.</p>
        </article>
        <article>
          <p class="system-number">02</p>
          <h3>Mặt đá nối thao tác</h3>
          <p>Các vùng chuẩn bị, nấu và vệ sinh liên tục, vừa tầm với người sử dụng.</p>
        </article>
        <article>
          <p class="system-number">03</p>
          <h3>Thiết bị vào đúng chỗ</h3>
          <p>Kích thước và luồng sử dụng được cân nhắc trước khi hoàn thiện hệ tủ.</p>
        </article>
        <article>
          <p class="system-number">04</p>
          <h3>Vùng nước khép vòng</h3>
          <p>Chậu, vòi, mặt đá và khoang dưới chậu được phối hợp thành một cụm sử dụng.</p>
        </article>
      </div>
    </section>

    <section class="section standards" aria-labelledby="standards-title">
      <div class="container standards-grid">
        <div class="standards-heading">
          <p class="eyebrow">Tiêu chuẩn tuyển chọn</p>
          <h2 id="standards-title">Không chọn nhiều.<br />Chọn có lý do.</h2>
        </div>
        <div class="standards-list">
          {
            selectionStandards.map((standard, index) => (
              <article>
                <p class="standard-number">0{index + 1}</p>
                <div>
                  <h3>{standard.title}</h3>
                  <p>{standard.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section process" id="quy-trinh" aria-labelledby="process-title">
      <div class="container process-heading">
        <p class="eyebrow">Một đầu mối xuyên suốt</p>
        <h2 id="process-title">Từ điều gia đình cần đến căn bếp sử dụng mỗi ngày.</h2>
        <p class="lede">
          Quy trình giúp từng lựa chọn được đặt đúng ngữ cảnh, thay vì để khách hàng tự xử
          lý những điểm giao nhau giữa nhiều hạng mục.
        </p>
      </div>
      <ol class="container process-list">
        {
          processSteps.map((step) => (
            <li>
              <p class="process-number">{step.order}</p>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <ShowroomCta />
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <img src="/brand/bep-am-logo.png" width="886" height="822" alt="Bếp Ấm - Bếp ấm, Nhà êm" />
        <p>Giải pháp không gian bếp trọn gói tại Cần Thơ.</p>
      </div>
      <div>
        <p class="footer-label">Liên hệ</p>
        <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
        <p>{contact.address}</p>
      </div>
      <div>
        <p class="footer-label">Khám phá</p>
        <a href="#giai-phap">Bốn lớp giải pháp</a>
        <a href="#ben-trong-lecmax">Bên trong Lecmax</a>
        <a href="#quy-trinh">Quy trình đồng hành</a>
      </div>
      <p class="footer-copyright">© {new Date().getFullYear()} Bếp Ấm.</p>
    </div>
  </footer>
</BaseLayout>
