---
import BaseLayout from "../layouts/base-layout.astro";
import SiteHeader from "../components/site-header.astro";
import KitchenStory from "../components/kitchen-story.astro";
import KitchenSlideshow from "../components/kitchen-slideshow.astro";
import CollectionShowcase from "../components/collection-showcase.astro";
import FactoryStory from "../components/factory-story.astro";
import AccessoriesStory from "../components/accessories-story.astro";
import KnowledgeStory from "../components/knowledge-story.astro";
import ShowroomMedia from "../components/showroom-media.astro";
import "../styles/home-stories.css";
import ShowroomCta from "../components/showroom-cta.astro";
import { contact, processSteps, solutionLayers } from "../data/site-content";
import "../styles/home.css";
const title = "Bếp Ấm | Giải pháp không gian bếp trọn gói tại Cần Thơ";
const description =
  "Cùng Bếp Ấm tìm giải pháp bếp phù hợp với gia đình: hệ tủ Lecmax, mặt đá, thiết bị và chậu vòi đồng bộ. Đặt lịch tư vấn tại showroom Cần Thơ.";
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: "Bếp Ấm",
  description,
  telephone: [contact.phoneHref.slice(4), contact.secondaryPhoneHref.slice(4)],
  address: {
    "@type": "PostalAddress",
    streetAddress: "168C Xô Viết Nghệ Tĩnh",
    addressLocality: "Ninh Kiều",
    addressRegion: "Cần Thơ",
    addressCountry: "VN",
  },
  sameAs: [contact.facebookHref],
  hasMap: contact.mapHref,
};
---

<BaseLayout
  title={title}
  description={description}
  image="/images/kitchen-concept-1-1600.webp"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(localBusiness)}
    is:inline
  ></script>
  <link
    slot="head"
    rel="preload"
    href="/fonts/newsreader-regular.ttf"
    as="font"
    type="font/ttf"
    crossorigin
  />
  <SiteHeader />
  <main id="noi-dung-chinh">
    <section class="hero container" id="top" aria-labelledby="hero-title">
      <div class="hero-intro">
        <div class="hero-copy">
          <p class="eyebrow">Showroom giải pháp bếp · Cần Thơ</p>
          <h1 id="hero-title">
            Một nơi,
            <br />
            <em>trọn vẹn gian bếp.</em>
          </h1>
          <p class="lede">
            Từ hệ tủ đến mặt đá, thiết bị và chậu vòi. Bếp Ấm kết nối từng lựa
            chọn cho căn bếp của gia đình bạn.
          </p>
          <div class="actions">
            <a class="button button--primary" href="#tu-van">
              Đặt lịch tư vấn <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#bo-suu-tap">
              Khám phá bộ sưu tập <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
        <aside class="hero-aside" aria-label="Thông tin showroom">
          <p>
            Một đầu mối
            <br />
            <strong>Tư vấn, thiết kế và thi công</strong>
          </p>
          <p>
            Tại showroom
            <br />
            <strong>Xem vật liệu. Thử thao tác.</strong>
          </p>
          <p>
            168C Xô Viết Nghệ Tĩnh
            <br />
            <strong>Ninh Kiều, Cần Thơ</strong>
          </p>
        </aside>
      </div>
      <KitchenSlideshow />
    </section>
    <CollectionShowcase />
    <section
      class="section container"
      id="cong-trinh"
      aria-labelledby="projects-title"
    >
      <div class="section-intro">
        <p class="section-label">Bên trong showroom</p>
        <div>
          <h2 id="projects-title">
            Đến để nhìn gần,
            <br />
            <em>chạm và trải nghiệm.</em>
          </h2>
          <p class="lede">
            Từ hệ tủ đến thiết bị và vật liệu. Xem trực tiếp từng phần để hình
            dung điều phù hợp với căn bếp của gia đình bạn.
          </p>
        </div>
      </div>
      <div class="project-grid">
        <article class="project-card">
          <img
            src="/images/showroom-kitchen-800.webp"
            width="800"
            height="600"
            loading="lazy"
            alt="Hệ tủ bếp màu ghi, mặt đá sáng và bàn đảo tại showroom Bếp Ấm"
          />
          <p class="project-meta">Không gian trưng bày · Bếp Ấm</p>
          <h3>Hình dung căn bếp của mình</h3>
          <p>
            Đứng bên bàn đảo, nhìn cách hệ tủ và mặt bếp kết nối. Một góc bếp
            thực tế giúp bạn dễ trao đổi về bố trí, màu sắc và thói quen sử
            dụng.
          </p>
          <details>
            <summary>Khám phá góc bếp</summary>
            <p>
              Tại showroom, bạn có thể quan sát hệ tủ cao, khu vực nấu và bàn
              đảo trong cùng một không gian. Phương án cho nhà bạn sẽ được tư
              vấn theo mặt bằng thực tế.
            </p>
            <a href="#tu-van">Trao đổi về căn bếp của bạn ↗</a>
          </details>
        </article>
        <article class="project-card">
          <img
            src="/images/showroom-appliances-800.webp"
            width="800"
            height="600"
            loading="lazy"
            alt="Khu trưng bày thiết bị Panasonic cùng các mẫu bếp và máy hút mùi tại Bếp Ấm"
          />
          <p class="project-meta">Thiết bị & thao tác · Bếp Ấm</p>
          <h3>Chọn từ cách mình sử dụng</h3>
          <p>
            Quan sát thiết bị ở khoảng cách gần, so sánh kích thước và cách bố
            trí trước khi chọn cho căn bếp của gia đình.
          </p>
          <details>
            <summary>Khám phá khu thiết bị</summary>
            <p>
              Khu trưng bày Panasonic đặt cạnh các mẫu chậu vòi để bạn hình dung
              các vùng nấu và rửa. Cùng Bếp Ấm trao đổi về nhu cầu sử dụng và
              lựa chọn phù hợp.
            </p>
            <a href="#tu-van">Hẹn trải nghiệm tại showroom ↗</a>
          </details>
        </article>
      </div>
      <p class="source-note">
        Hình ảnh thực tế tại showroom Bếp Ấm. Bố trí và lựa chọn cho mỗi gia
        đình được tư vấn riêng.
      </p>
    </section>
    <section
      class="section container"
      id="giai-phap"
      aria-labelledby="solutions-title"
    >
      <div class="section-intro">
        <p class="section-label">Giải pháp trọn gói</p>
        <div>
          <h2 id="solutions-title">
            Đẹp ở từng phần.
            <br />
            <em>Đồng bộ khi sử dụng.</em>
          </h2>
          <p class="lede">
            Bếp Ấm tính đến những điểm giao nhau giữa hệ tủ, mặt đá, thiết bị và
            vùng nước ngay từ phương án đầu tiên.
          </p>
        </div>
      </div>
      <div class="solution-list">
        {solutionLayers.map((layer) => (
          <article class="solution-item">
            <p class="brand-name">{layer.brand}</p>
            <h3>{layer.role}</h3>
            <p>{layer.summary}</p>
          </article>
        ))}
      </div>
      <p class="source-note">
        Hệ tủ Lecmax là nền tảng của giải pháp. Panasonic, Konox và Vicostone là
        lựa chọn tiêu chuẩn khi bạn chưa chọn riêng thiết bị, chậu vòi hoặc mặt
        đá.
      </p>
    </section>
    <FactoryStory />
    <AccessoriesStory />
    <section
      class="section container material-story"
      aria-labelledby="materials-title"
    >
      <figure>
        <img
          src="/images/showroom-storage-800.webp"
          width="800"
          height="1067"
          loading="lazy"
          alt="Giá bát nâng hạ đang mở phía trên chậu rửa tại showroom Bếp Ấm"
        />
        <figcaption class="caption">
          <span>Giá bát nâng hạ · Trải nghiệm tại Bếp Ấm.</span>
        </figcaption>
      </figure>
      <div class="material-copy">
        <p class="section-label">Vật liệu & chi tiết</p>
        <h2 id="materials-title">
          Chất lượng nằm ở<br />
          <em>điều dùng mỗi ngày.</em>
        </h2>
        <p>
          Ở bề mặt dễ lau. Ở ngăn kéo vừa tay. Ở những mối nối được tính cùng
          nhau trước khi lắp đặt.
        </p>
        <ul class="material-points">
          <li>
            <strong>Hệ tủ inox 304</strong>
            <span>Cấu tạo module, hai mặt inox và lõi nhôm tổ ong.</span>
          </li>
          <li>
            <strong>Bề mặt & thiết bị</strong>
            <span>
              Chọn theo thói quen sử dụng, bố trí theo mặt bằng thực tế.
            </span>
          </li>
          <li>
            <strong>Chi tiết lưu trữ</strong>
            <span>Thử trực tiếp để biết điều gì thuận tay với mình.</span>
          </li>
        </ul>
      </div>
    </section>
    <section
      class="section container showroom-details"
      aria-labelledby="details-title"
    >
      <div class="section-intro">
        <p class="section-label">Nhìn gần hơn</p>
        <div>
          <h2 id="details-title">
            Từng lựa chọn,
            <br />
            <em>đều có thể cảm nhận.</em>
          </h2>
          <p class="lede">
            Đặt các mẫu cạnh nhau, chạm bề mặt và thử thao tác. Những chi tiết
            nhỏ giúp quyết định trở nên rõ ràng hơn.
          </p>
        </div>
      </div>
      <div class="detail-gallery">
        <figure>
          <img
            src="/images/showroom-materials-800.webp"
            width="800"
            height="1067"
            loading="lazy"
            alt="Các tấm mẫu bề mặt với màu sắc và vân khác nhau trên giá trưng bày"
          />
          <figcaption>
            <h3>So sánh vật liệu</h3>
            <p>Nhìn màu và vân thật dưới ánh sáng của không gian.</p>
          </figcaption>
        </figure>
        <figure>
          <img
            src="/images/showroom-sinks-800.webp"
            width="800"
            height="1067"
            loading="lazy"
            alt="Các mẫu chậu rửa và vòi tại khu trưng bày Konox của Bếp Ấm"
          />
          <figcaption>
            <h3>Thử vùng nước</h3>
            <p>Quan sát lòng chậu, tầm với và cách bố trí vòi.</p>
          </figcaption>
        </figure>
        <figure>
          <img
            src="/images/showroom-entrance-800.webp"
            width="800"
            height="600"
            loading="lazy"
            alt="Lối vào showroom với biển Lecmax và các khu trưng bày bếp hai bên"
          />
          <figcaption>
            <h3>Ghé để cùng trao đổi</h3>
            <p>Đi qua từng góc trưng bày, tìm điều phù hợp với gia đình.</p>
          </figcaption>
        </figure>
      </div>
    </section>
    <KitchenStory />
    <ShowroomMedia />
    <KnowledgeStory />
    <section
      class="section container"
      id="quy-trinh"
      aria-labelledby="process-title"
    >
      <div class="section-intro">
        <p class="section-label">Cùng bạn, từ đầu đến cuối</p>
        <div>
          <h2 id="process-title">
            Bắt đầu bằng
            <br />
            <em>một cuộc trò chuyện.</em>
          </h2>
          <p class="lede">
            Một đầu mối xuyên suốt, để bạn hiểu từng lựa chọn trước khi quyết
            định.
          </p>
        </div>
      </div>
      <ol class="process-list">
        {processSteps.map((step) => (
          <li>
            <p class="process-number">{step.order}</p>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </section>
    <ShowroomCta />
  </main>
  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <p>Bếp ấm, Nhà êm.</p>
        <p>© {new Date().getFullYear()} Bếp Ấm · Giải pháp bếp tại Cần Thơ</p>
      </div>
      <a href={contact.facebookHref} target="_blank" rel="noreferrer">
        Facebook Bếp Ấm ↗
      </a>
      <a href="#showroom">Ghé showroom trải nghiệm ↗</a>
    </div>
  </footer>
</BaseLayout>
