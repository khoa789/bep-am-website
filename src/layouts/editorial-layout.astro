---
import BaseLayout from "./base-layout.astro";
import SiteHeader from "../components/site-header.astro";
import ShowroomCta from "../components/showroom-cta.astro";
import "../styles/home.css";
import "../styles/editorial.css";
interface Props {
  title: string;
  description: string;
  image: string;
  category: string;
}
const { title, description, image, category } = Astro.props;
---

<BaseLayout title={`${title} | Bếp Ấm`} description={description} image={image}>
  <SiteHeader />
  <main id="noi-dung-chinh">
    <article class="container editorial-page">
      <a class="text-link" href="/">
        ← Về trang chủ
      </a>
      <header>
        <p class="section-label">{category}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
      </header>
      <slot />
    </article>
    <ShowroomCta />
  </main>
</BaseLayout>
